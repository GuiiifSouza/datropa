# Copie para .env.local (fora do git). Todas são opcionais.

# De onde vêm os dados: auto (API real e, se ela não responder, o snapshot), api ou snapshot.
VITE_FONTE_DADOS=auto

# Em dev, manda /api/** para este host (os mesmos rewrites do Firebase Hosting).
# VITE_API_PROXY=https://devs.datropa.com

# Config web do Firebase para rodar fora do Hosting. No Hosting ela vem de /__/firebase/init.json.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=datropa.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=datropa
# VITE_FIREBASE_APP_ID=

# 1 liga as artes de agente da Riot em public/arte/agentes. Só depois do OK da organização.
VITE_ARTE_RIOT=0
